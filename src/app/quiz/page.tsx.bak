"use client";

import React, { useState, useCallback } from "react";
import { Card, CardContent } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import { Alert, AlertTitle } from "@/components/ui/alert";
import Link from "next/link";
import { z } from "zod";
import { zodResolver } from "@hookform/resolvers/zod";
import {
  Form,
  FormControl,
  FormField,
  FormItem,
  FormLabel,
  FormMessage,
} from "@/components/ui/form";
import { useForm } from "react-hook-form";
import { Upload, Brain } from "lucide-react";

interface Question {
  question: string;
  options: string[];
  correct_answer: string;
}

const formSchema = z.object({
  file: z.any().refine((file) => file?.name, "Please select a PPT file"),
});

type FormValues = z.infer<typeof formSchema>;

export default function QuizFromPPT() {
  const [quiz, setQuiz] = useState<Question[]>([]);
  const [answers, setAnswers] = useState<Record<number, string>>({});
  const [score, setScore] = useState<number | null>(null);
  const [pending, setPending] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [pptText, setPptText] = useState<string>("");

  const form = useForm<FormValues>({
    resolver: zodResolver(formSchema),
  });

  const onSubmit = async (values: FormValues) => {
    const file = values.file;
    if (!file) return setError("Please select a PPT file.");

    setError(null);
    setQuiz([]);
    setScore(null);
    setPending(true);

    try {
      // Step 1️⃣ — Send PPT file to Flask backend for extraction
      const formData = new FormData();
      formData.append("file", file);

      const extractRes = await fetch("/api/evaluate_ppt", {
        method: "POST",
        body: formData,
      });

      if (!extractRes.ok) {
        throw new Error("Failed to extract text from PPT");
      }

      const { text: extractedText } = await extractRes.json();
      setPptText(extractedText);

      // Step 2️⃣ — Send extracted text to /generate-quiz
      const quizRes = await fetch("/api/generate-quiz", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ text: extractedText }),
      });

      if (!quizRes.ok) {
        throw new Error("Failed to generate quiz");
      }

      const { quiz: generatedQuiz } = await quizRes.json();
      setQuiz(generatedQuiz);
    } catch (err: any) {
      console.error(err);
      setError(err.message || "Something went wrong.");
    } finally {
      setPending(false);
    }
  };

  const handleAnswer = useCallback((qIndex: number, answer: string) => {
    setAnswers((prev) => ({ ...prev, [qIndex]: answer }));
  }, []);

  const handleSubmitQuiz = () => {
    let correct = 0;
    quiz.forEach((q, i) => {
      if (answers[i] === q.correct_answer) correct++;
    });
    setScore(correct);
  };

  return (
    <div className="min-h-screen bg-gradient-to-b from-neutral-900 via-black to-neutral-900 text-white p-8">
      <div className="max-w-3xl mx-auto space-y-6">
        <h1 className="text-3xl font-bold text-emerald-300">
          📊 PPT Quiz Generator
        </h1>
        <p className="text-gray-400">
          Upload your PowerPoint presentation. We’ll extract the text, create a
          quiz, and let you test yourself!
        </p>

        <Card>
          <CardContent className="space-y-4 p-6">
            <Input
              type="file"
              accept=".ppt,.pptx"
              onChange={handleFileChange}
              className="bg-neutral-800 border-neutral-700 text-white"
            />
            <Button onClick={handleGenerateQuiz} disabled={loading || !file}>
              {loading ? "Processing..." : "Generate Quiz"}
            </Button>

            {error && (
              <Alert className="bg-destructive/10 border-none">
                <AlertTitle>{error}</AlertTitle>
              </Alert>
            )}
          </CardContent>
        </Card>

        {pptText && (
          <div className="text-sm text-gray-400 mt-2 border border-neutral-700 rounded p-3 bg-neutral-900/50">
            <strong>Extracted Text Preview:</strong>
            <p className="mt-1 line-clamp-3">{pptText.slice(0, 400)}...</p>
          </div>
        )}

        {quiz.length > 0 && (
          <Card className="mt-6">
            <CardContent className="space-y-6 p-6">
              <h2 className="text-xl font-semibold text-emerald-300">
                🧠 Quiz
              </h2>
              {quiz.map((q, index) => (
                <div key={index} className="space-y-3">
                  <div className="font-medium text-lg text-white">
                    {index + 1}. {q.question}
                  </div>
                  <div className="space-y-2">
                    {q.options.map((opt, optIdx) => (
                      <label
                        key={optIdx}
                        className={`block cursor-pointer p-2 rounded border ${
                          answers[index] === opt
                            ? "bg-emerald-700 border-emerald-500"
                            : "bg-neutral-800 border-neutral-700 hover:border-emerald-400"
                        }`}
                      >
                        <input
                          type="radio"
                          name={`q-${index}`}
                          value={opt}
                          checked={answers[index] === opt}
                          onChange={() => handleAnswer(index, opt)}
                          className="mr-2 accent-emerald-500"
                        />
                        {opt}
                      </label>
                    ))}
                  </div>
                </div>
              ))}
              <Button
                onClick={handleSubmit}
                disabled={Object.keys(answers).length < quiz.length}
              >
                Submit Quiz
              </Button>

              {score !== null && (
                <div className="mt-6 text-center text-2xl font-bold text-emerald-300">
                  ✅ Your Score: {score}/{quiz.length}
                </div>
              )}
            </CardContent>
          </Card>
        )}
      </div>
    </div>
  );
}
